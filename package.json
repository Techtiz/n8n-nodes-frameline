{
  "name": "n8n-nodes-frameline",
  "version": "0.1.2",
  "description": "n8n community node for Frameline \u2014 render design templates to PNG, JPEG or PDF from a workflow.",
  "keywords": [
    "n8n-community-node-package",
    "frameline",
    "image-generation",
    "template",
    "render"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Techtiz/n8n-nodes-frameline#readme",
  "author": {
    "name": "Techtiz",
    "url": "https://github.com/Techtiz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Techtiz/n8n-nodes-frameline.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FramelineApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Frameline/Frameline.node.js",
      "dist/nodes/Frameline/FramelineTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "~2.16.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/Techtiz/n8n-nodes-frameline/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
