{
  "name": "n8n-nodes-frameline",
  "version": "0.1.4",
  "description": "n8n community node for Frameline \u2014 render design templates to PNG, JPEG or PDF from a workflow.",
  "keywords": [
    "n8n-community-node-package",
    "frameline",
    "image-generation",
    "template",
    "render"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Techtiz/n8n-nodes-frameline#readme",
  "author": {
    "name": "Techtiz",
    "email": "utahir@techtiz.co",
    "url": "https://github.com/Techtiz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Techtiz/n8n-nodes-frameline.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build && npm run lint",
    "test": "npm run lint && npm run build"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FramelineApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Frameline/Frameline.node.js",
      "dist/nodes/Frameline/FramelineTrigger.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.47.0",
    "@types/node": "^20.19.43",
    "n8n-workflow": "~2.16.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/Techtiz/n8n-nodes-frameline/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
